{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-settings/main/schema.json",
  "productName": "DocForge",
  "version": "2.0.0",
  "identifier": "com.docforge.desktop",
  "mainBinaryName": "docforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --port 5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DocForge - Document Automation",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "msix"
    ],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/sidebar.bmp"
      },
      "msix": {
        "displayName": "DocForge",
        "publisherDisplayName": "DocForge",
        "identityName": "DocForge.DocForge",
        "publisher": "CN=DocForge"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "fileAssociations": [
      {
        "ext": ["dfpkg"],
        "name": "DocForge Package",
        "description": "DocForge template package"
      }
    ]
  }
}
